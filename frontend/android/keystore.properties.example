# Copy to frontend/android/keystore.properties and fill.
# Put the .jks in frontend/android/ (path below is relative to app/).
# NEVER commit keystore.properties or *.jks — both are git-ignored.
# Generate the keystore once (backup the .jks + passwords somewhere safe —
# lose them and you can never publish updates for the same appId again):
#
#   cd frontend/android
#   keytool -genkeypair -v -keystore ressist-release.jks -alias ressist \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then get the SHA-1 for the Android OAuth client (Google Cloud Console):
#
#   keytool -list -v -keystore ressist-release.jks -alias ressist | grep SHA1

storeFile=../ressist-release.jks
storePassword=change-me
keyAlias=ressist
keyPassword=change-me
