# ===== Client (Vite, prefix VITE_ -> ikut ke-bundle ke browser) =====
# URL publik frontend (dipakai redirect logout di BFF)
VITE_APP_URL=http://localhost:5173
# URL publik Go backend (dipakai hanya sebagai fallback display; data selalu via /api BFF)
VITE_API_URL=http://localhost:8080

# ===== Server / BFF (Vercel Functions & bun run server) — JANGAN prefix VITE_ =====
# Override server-only untuk base URL Go backend (disamakan dengan VITE_API_URL di prod)
# BACKEND_API_URL=http://localhost:8080
# Secret JWT cookie el-learning-session (wajib sama dengan backend bila diverifikasi di sana)
SESSION_SECRET=your-random-session-secret-min-32-chars-long
# Domain cookie (opsional, mis. .vercel.app atau domain custom). Kosongkan untuk same-host.
# COOKIE_DOMAIN=

# ===== Lokal dev =====
# BFF port (vite proxy /api -> sini). Default 3001.
# BFF_PORT=3001
# Serve dist/ langsung dari BFF (mode single-serve Nixpacks): SERVE_STATIC=1

# ===== Legacy (fallback, deprecated) =====
# NEXT_PUBLIC_APP_URL / NEXT_PUBLIC_API_URL / NEXT_PUBLIC_COOKIE_DOMAIN masih dibaca
# sebagai fallback bila varian baru belum di-set. Jangan pakai untuk env baru.
