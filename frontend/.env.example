NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional override for server-side route handlers.
# If not set, frontend uses NEXT_PUBLIC_API_URL.
# BACKEND_API_URL=http://localhost:8080

SESSION_SECRET=your-random-session-secret-min-32-chars-long

# PostgreSQL connection string (Neon). Required for `prisma generate` /
# `prisma migrate` (loaded via prisma.config.ts) and for the app runtime
# (Prisma Postgres adapter in lib/prisma.ts).
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
