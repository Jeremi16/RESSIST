# ==========================================
# Database Configuration (Neon PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Next.js Configuration
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-long"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8080"

# Secret untuk enkripsi session cookie (generate random string, min 32 chars)
SESSION_SECRET="your-random-session-secret-min-32-chars-long"

# ==========================================
# Google OAuth Configuration (REQUIRED for Auth)
# ==========================================
# Frontend now redirects OAuth flow to backend.
# Configure Google redirect URI to backend callback instead:
#   - http://localhost:8080/auth/google/callback (dev)
#   - https://resisst-api.nodryx.com/auth/google/callback (prod)

GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ==========================================
# Telegram Bot Configuration (Optional)
# ==========================================
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# ==========================================
# WhatsApp Cloud API (Optional - for WhatsApp reminders)
# ==========================================
WHATSAPP_CLOUD_API_TOKEN="your-whatsapp-cloud-api-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
