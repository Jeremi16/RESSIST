<?xml version="1.0" encoding="utf-8"?>
<!-- Dev-only cleartext allowance. Release builds talk to https:// backends,
     so this has no effect in production. Extend with your LAN IP when
     testing on a physical device against a local backend, e.g.:
     <domain includeSubdomains="false">192.168.1.10</domain> -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
