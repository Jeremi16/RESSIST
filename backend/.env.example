ENV=development
PORT=8080

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ressist?sslmode=disable

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback
# Legacy legacy /auth/google/callback masih di-alias di router.go, tapi prefer /v1
ALLOWED_EMAIL_DOMAIN=student.itera.ac.id

JWT_ACCESS_SECRET=replace-with-strong-random-secret

FRONTEND_URL=http://localhost:3000

COOKIE_DOMAIN=
COOKIE_SECURE=false

ALLOWED_ORIGINS=http://localhost:3000

API_KEY_PREFIX=rsk_
API_KEY_MAX_PER_USER=5
API_KEY_RATE_LIMIT_PER_MINUTE=60
API_KEY_RATE_LIMIT_BURST=20

# Standalone ressist-bot service (bot/) authenticates with this token.
# Generate: openssl rand -hex 32
# Empty = bot integration disabled (/internal/* returns 503).
BOT_SERVICE_TOKEN=replace-with-random-32-byte-hex

# Telegram — must match bot/.env and root .env (docker-compose).
# Empty = telegram sender disabled (/v1/telegram/test-* returns 503).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=ressist_bot

# LMS daily sync 07:00 WIB — marks Moodle-done tasks as completed so they disappear from calendar
LMS_SYNC_ENABLED=true
LMS_SYNC_CRON=0 7 * * *
LMS_SYNC_BATCH_SIZE=200
LMS_SYNC_CONCURRENCY=2
LMS_SYNC_TIMEOUT_SECONDS=90
