ENV=development
PORT=8080

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resisst?sslmode=disable
AUTO_MIGRATE=true
REQUEST_TIMEOUT_SECONDS=15
SHUTDOWN_TIMEOUT_SECONDS=20
AUTH_RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_BURST=10

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://resisst-api.nodryx.com/auth/google/callback
ALLOWED_EMAIL_DOMAIN=student.itera.ac.id

JWT_ACCESS_SECRET=replace-with-strong-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=720

FRONTEND_URL=https://resisst.nodryx.com
FRONTEND_SUCCESS_PATH=/login?auth=success
FRONTEND_ERROR_PATH=/login?error=oauth

COOKIE_DOMAIN=.nodryx.com
COOKIE_SECURE=true

ALLOWED_ORIGINS=https://resisst.nodryx.com,https://resisst.vercel.app,http://localhost:3000
