ENV=development
PORT=8080

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ressist?sslmode=disable

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback
# Legacy legacy /auth/google/callback masih di-alias di router.go, tapi prefer /v1
ALLOWED_EMAIL_DOMAIN=student.itera.ac.id

JWT_ACCESS_SECRET=replace-with-strong-random-secret

# Sesi web 3 hari + sliding: tiap refresh, expiry diperpanjang 72 jam.
# JANGAN ubah angka ini tanpa menyamakan SESSION_TTL_DAYS di frontend.
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_HOURS=72
# Sesi Android native (KMP) 30 hari + sliding via POST /v1/auth/google/native.
# Absolute max 90 hari tetap paksa login ulang walau aktif terus.
MOBILE_REFRESH_TOKEN_TTL_HOURS=720
REFRESH_TOKEN_ABSOLUTE_MAX_DAYS=90
# Toleransi race rotasi refresh (BFF multi-instance / tab paralel / mobile
# UI + SyncWorker). Pemakaian ulang token yang sudah dirotasi di dalam
# window ini dianggap jinak dan diberi token kompensasi, bukan pencurian.
# HANYA berlaku untuk token yang di-revoke karena ROTASI. Token yang
# di-revoke karena logout atau reuse tidak pernah mendapat grace.
# Default kode = 30. Naikkan hanya bila klien Anda benar-benar menembak
# request paralel dengan token yang sama.
REFRESH_REUSE_GRACE_SECONDS=30

FRONTEND_URL=http://localhost:3000

COOKIE_DOMAIN=
COOKIE_SECURE=false

# Comma-separated. http(s) origins go to CORS AllowOrigins, custom schemes
# (e.g. native WebView) go to AllowOriginFunc.
# Bare domains / paths / "*" are skipped with a warning, never panic.
# Contoh produksi: ALLOWED_ORIGINS=https://ressist.web.id,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

API_KEY_PREFIX=rsk_
API_KEY_MAX_PER_USER=5
API_KEY_RATE_LIMIT_PER_MINUTE=60
API_KEY_RATE_LIMIT_BURST=20
# CIDR proxy yang boleh mengisi X-Forwarded-For. KOSONG = tidak ada proxy
# tepercaya, sehingga ClientIP() = alamat TCP peer (aman untuk deployment
# tanpa proxy, dan tidak bisa dipalsukan lewat header).
# Isi eksplisit bila di belakang Coolify/Traefik/nginx, contoh:
# TRUSTED_PROXIES=10.0.0.0/8,172.17.0.0/16
# Entri tidak valid membuat proses gagal start (fail fast).
TRUSTED_PROXIES=

# Limiter murah per-IP SEBELUM kredensial diverifikasi.
PREAUTH_RATE_LIMIT_PER_MINUTE=300
PREAUTH_RATE_LIMIT_BURST=120

# Tombol "test notification" di dashboard (memakai kuota bot bersama).
TELEGRAM_TEST_RATE_LIMIT_PER_MINUTE=5
TELEGRAM_TEST_RATE_LIMIT_BURST=2

# Anggaran sync LMS per-user (preview force, /v1/calendar/test, /auth/sync).
SYNC_RATE_LIMIT_PER_MINUTE=6
SYNC_RATE_LIMIT_BURST=3

# Standalone ressist-bot service (bot/) authenticates with this token.
# Generate: openssl rand -hex 32
# Empty = bot integration disabled (/internal/* returns 503).
BOT_SERVICE_TOKEN=replace-with-random-32-byte-hex

# Telegram — must match bot/.env and root .env (docker-compose).
# Empty = telegram sender disabled (/v1/telegram/test-* returns 503).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=ressist_bot

# LMS daily sync 07:00 WIB — marks Moodle-done tasks as completed so they disappear from calendar
LMS_SYNC_ENABLED=true
LMS_SYNC_CRON=0 7 * * *
LMS_SYNC_BATCH_SIZE=200
LMS_SYNC_CONCURRENCY=2
LMS_SYNC_TIMEOUT_SECONDS=90

# Retensi events: hapus baris completed/missed yang lebih tua dari N hari.
# Baris pending TIDAK pernah dihapus. Tanpa ini tabel events tumbuh terus
# dan semua batas LIMIT hanya menunda masalah.
EVENT_RETENTION_ENABLED=true
EVENT_RETENTION_DAYS=90
EVENT_RETENTION_CRON=30 3 * * *
