{
  "openapi": "3.0.3",
  "info": {
    "title": "Resisst API",
    "version": "1.0.0",
    "description": "Auth API for Resisst"
  },
  "servers": [
    {
      "url": "https://resisst-api.nodryx.com"
    },
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/livez": {
      "get": {
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Service is alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness probe",
        "responses": {
          "200": {
            "description": "Service is ready"
          },
          "503": {
            "description": "Service is not ready"
          }
        }
      }
    },
    "/v1/auth/google/login": {
      "get": {
        "summary": "Start Google OAuth login",
        "responses": {
          "307": {
            "description": "Redirect to Google OAuth"
          }
        }
      }
    },
    "/v1/auth/google/callback": {
      "get": {
        "summary": "Google OAuth callback",
        "responses": {
          "307": {
            "description": "Redirect to frontend after auth"
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "responses": {
          "200": {
            "description": "Refreshed access token"
          },
          "401": {
            "description": "Invalid refresh token"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Logout and revoke refresh token",
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "summary": "Current user profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/user": {
      "get": {
        "summary": "Get current user settings/profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user settings"
          }
        }
      },
      "put": {
        "summary": "Update current user settings/profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Updated user settings"
          }
        }
      }
    },
    "/v1/user/google/disconnect": {
      "post": {
        "summary": "Disconnect Google Classroom for current user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Disconnected"
          }
        }
      }
    },
    "/v1/calendar/preview": {
      "get": {
        "summary": "Get calendar preview from cached assignments",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Calendar preview"
          }
        }
      }
    },
    "/v1/calendar/test": {
      "post": {
        "summary": "Test selected LMS sources (cache-based)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Test result"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
