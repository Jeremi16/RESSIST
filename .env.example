# Copy to .env and fill. Used by docker-compose.yml (root).
# Generate secrets: openssl rand -hex 32

DB_USER=ressist
DB_PASSWORD=change-me
DB_NAME=ressist

API_PORT=8080
BOT_PORT=8081
# Batas memori container. Naikkan bila ada lonjakan OOM pada sync besar.
API_MEM_LIMIT=512m
BOT_MEM_LIMIT=256m

# Skema database dikelola migrasi bernomor (backend/internal/database/migrate.go).
# Compose produksi menyetel AUTO_MIGRATE=false dan menjalankan langkah rilis:
#   docker compose run --rm api migrate
# Set true hanya bila Anda ingin migrasi diterapkan otomatis saat api start
# (aman untuk N replika: ada advisory lock + tabel schema_migrations).
AUTO_MIGRATE=false

# Must be identical in backend (.env BOT_SERVICE_TOKEN) and bot service.
BOT_SERVICE_TOKEN=replace-with-random-32-byte-hex

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=ressist_bot

JWT_ACCESS_SECRET=replace-with-strong-random-secret
# JANGAN regenerate secret ini saat redeploy — semua sesi user akan mati.
# Sesi web 3 hari + sliding (samakan dengan SESSION_TTL_DAYS di Vercel).
# Sesi Android native 30 hari sliding (MOBILE_REFRESH_TOKEN_TTL_HOURS=720).
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_HOURS=72
MOBILE_REFRESH_TOKEN_TTL_HOURS=720
REFRESH_TOKEN_ABSOLUTE_MAX_DAYS=90
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://your-api-domain/v1/auth/google/callback
ALLOWED_EMAIL_DOMAIN=student.itera.ac.id
FRONTEND_URL=https://your-frontend-domain
# Path redirect setelah login Google (web). Kosongkan untuk pakai default.
FRONTEND_SUCCESS_PATH=/login?auth=success
FRONTEND_ERROR_PATH=/login
# Comma-separated. http(s) → AllowOrigins, custom scheme (mis. WebView) → AllowOriginFunc.
# Bare domain / path / "*" dilewati dengan warning (tidak panic).
# https://your-frontend-domain,http://localhost,https://localhost
ALLOWED_ORIGINS=https://your-frontend-domain

# ---------- Reverse proxy / rate limit ----------
# WAJIB diisi bila api berada di belakang reverse proxy (Coolify, Traefik,
# nginx, Cloudflare Tunnel). Comma-separated CIDR.
# Kosong = tidak ada proxy dipercaya -> c.ClientIP() = IP proxy -> SEMUA
# pengguna berbagi satu kuota rate limit per-IP (429 massal).
# Terlalu luas (mis. 0.0.0.0/0) = klien bisa memalsukan X-Forwarded-For.
# Contoh Docker network: 172.16.0.0/12
TRUSTED_PROXIES=

# Pre-auth limiter (per IP, sebelum kredensial diverifikasi).
PREAUTH_RATE_LIMIT_PER_MINUTE=300
PREAUTH_RATE_LIMIT_BURST=120

# Per-user sync limiter. Satu budget dipakai bersama oleh:
#   GET /v1/calendar/preview?force=true, POST /v1/calendar/test, POST /v1/auth/sync
SYNC_RATE_LIMIT_PER_MINUTE=6
SYNC_RATE_LIMIT_BURST=3

# Dashboard "test notification" buttons (shared operator quota).
TELEGRAM_TEST_RATE_LIMIT_PER_MINUTE=5
TELEGRAM_TEST_RATE_LIMIT_BURST=2

# ---------- Retention & API key ----------
# 0 = API key tanpa default expiry (hidup selamanya).
API_KEY_DEFAULT_EXPIRY_DAYS=90
API_KEY_PREFIX=rsk_
API_KEY_MAX_PER_USER=5
API_KEY_RATE_LIMIT_PER_MINUTE=60
API_KEY_RATE_LIMIT_BURST=20
# Tanpa retensi, tabel events tumbuh tanpa batas.
EVENT_RETENTION_ENABLED=true
EVENT_RETENTION_DAYS=90
EVENT_RETENTION_CRON=30 3 * * *

# ---------- Auth / cookie / timeout ----------
# Limiter endpoint auth (login/callback/refresh), per IP, pre-auth.
AUTH_RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_BURST=10
# Isi bila frontend & api berada di subdomain berbeda.
# Contoh: .itera.ac.id
COOKIE_DOMAIN=
# Default true saat ENV=production. Set false HANYA untuk http lokal.
COOKIE_SECURE=true
REQUEST_TIMEOUT_SECONDS=15
SHUTDOWN_TIMEOUT_SECONDS=20

# ---------- Sinkronisasi LMS terjadwal ----------
LMS_SYNC_ENABLED=true
LMS_SYNC_CRON=0 7 * * *
LMS_SYNC_BATCH_SIZE=200
LMS_SYNC_CONCURRENCY=2
LMS_SYNC_TIMEOUT_SECONDS=90

# ---------- Refresh token ----------
# Grace untuk race pemakaian ulang refresh token yang baru dirotasi
# (BFF multi-instance / tab paralel). BUKAN grace untuk token yang sudah
# di-revoke karena logout atau terdeteksi dicuri.
REFRESH_REUSE_GRACE_SECONDS=30
