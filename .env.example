# Copy to .env and fill. Used by docker-compose.yml (root).
# Generate secrets: openssl rand -hex 32

DB_USER=resisst
DB_PASSWORD=change-me
DB_NAME=resisst

API_PORT=8080
BOT_PORT=8081

# Must be identical in backend (.env BOT_SERVICE_TOKEN) and bot service.
BOT_SERVICE_TOKEN=replace-with-random-32-byte-hex

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=resisst_bot

JWT_ACCESS_SECRET=replace-with-strong-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://your-api-domain/v1/auth/google/callback
ALLOWED_EMAIL_DOMAIN=student.itera.ac.id
FRONTEND_URL=https://your-frontend-domain
ALLOWED_ORIGINS=https://your-frontend-domain
