# Copy to .env and fill. Used by docker-compose.yml (root).
# Generate secrets: openssl rand -hex 32

DB_USER=ressist
DB_PASSWORD=change-me
DB_NAME=ressist

API_PORT=8080
BOT_PORT=8081

# Must be identical in backend (.env BOT_SERVICE_TOKEN) and bot service.
BOT_SERVICE_TOKEN=replace-with-random-32-byte-hex

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=ressist_bot

JWT_ACCESS_SECRET=replace-with-strong-random-secret
# JANGAN regenerate secret ini saat redeploy — semua sesi user akan mati.
# Sesi web 3 hari + sliding (samakan dengan SESSION_TTL_DAYS di Vercel).
# Sesi Android native 30 hari sliding (MOBILE_REFRESH_TOKEN_TTL_HOURS=720).
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_HOURS=72
MOBILE_REFRESH_TOKEN_TTL_HOURS=720
REFRESH_TOKEN_ABSOLUTE_MAX_DAYS=90
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://your-api-domain/v1/auth/google/callback
ALLOWED_EMAIL_DOMAIN=student.itera.ac.id
FRONTEND_URL=https://your-frontend-domain
# Comma-separated. http(s) → AllowOrigins, custom scheme (capacitor://, ionic://) → AllowOriginFunc.
# Bare domain / path / "*" dilewati dengan warning (tidak panic).
# https://your-frontend-domain,capacitor://localhost,http://localhost,https://localhost
ALLOWED_ORIGINS=https://your-frontend-domain,capacitor://localhost
