ENV=development
# Health server port for this bot service (separate from api :8080)
BOT_PORT=8081

# Base URL of resisst-api (100% via API, no DATABASE_URL here)
API_BASE_URL=http://localhost:8080
# Must match backend BOT_SERVICE_TOKEN
BOT_SERVICE_TOKEN=replace-with-same-token-as-backend

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=resisst_bot

# Long-poll timeout in seconds
BOT_POLL_TIMEOUT=60
